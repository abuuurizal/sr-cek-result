APP_NAME="Cek Result Live"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo-cek-result.solusina.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Konfigurasi Database MySQL di VPS (aaPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sql_demo_cek_result_solusina_id
DB_USERNAME=sql_demo_cek_result_solusina_id
DB_PASSWORD=ad080642c6bdb

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Kunci API Rahasia untuk menerima data push dari laptop/server lokal MyLaps
# Samakan nilai ini pada file .env project lokal (sr-cek-result)
SYNC_API_KEY=sr-sync-secret-key-2026
